# Copy to .env.prod and fill in. Used by docker-compose.prod.yml + deploy.sh.
# NEVER commit the real .env.prod (it's gitignored).

# ---- Domains (Caddy auto-HTTPS issues certs for these) ----
# For real deploy use your domains; for local test use ":80" for both.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# Public URLs the browser/media use (must match the domains above).
PUBLIC_API_URL=https://api.example.com
PUBLIC_MEDIA_URL=https://media.example.com
# Public IP the media SFU advertises for WebRTC (server's public IP).
MEDIA_ANNOUNCED_IP=203.0.113.10

# ---- Database (Postgres) ----
POSTGRES_USER=linguacall
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=linguacall

# ---- Auth ----
JWT_SECRET=generate-a-long-random-secret
REQUIRE_AUTH=false

# ---- CORS (the web origin) ----
CORS_ORIGINS=https://app.example.com

# ---- Media service shared token ----
MEDIA_SERVICE_TOKEN=generate-a-random-token

# ---- LLM provider (Azure OpenAI shown; or set OPENAI_API_KEY / GITHUB_TOKEN) ----
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o
# Optional realtime voice:
AZURE_OPENAI_REALTIME_ENDPOINT=
AZURE_OPENAI_REALTIME_DEPLOYMENT=

# ---- Realtime voice turn detection (barge-in) ----
# semantic_vad (OpenAI only; ignores "um/uh" thinking pauses) or server_vad
# (silence-threshold; also works on Azure). semantic_vad auto-falls back to
# server_vad on providers that lack it.
REALTIME_VAD_MODE=semantic_vad
REALTIME_VAD_EAGERNESS=medium        # semantic_vad: low|medium|high|auto
REALTIME_VAD_SILENCE_MS=700          # server_vad: pause length that ends a turn
REALTIME_VAD_THRESHOLD=0.5
REALTIME_VAD_PREFIX_MS=300

# ---- Rate limits ----
RATE_LIMIT_LLM=30/minute
RATE_LIMIT_EXEC=20/minute

# ---------- Payments ----------
FREE_INTERVIEW_QUOTA=2
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=production

REDIS_URL=redis://redis:6379/0

ENABLED_TRACKS=sde
ENABLE_PERSONA_CALLS=false

# ===== LLM provider (multi-provider, config-driven) =====
# Primary reasoning/chat model. For Kimi K2 (Moonshot):
LLM_PROVIDER=custom
CUSTOM_LLM_BASE_URL=https://api.moonshot.ai/v1
CUSTOM_LLM_API_KEY=sk-your-moonshot-key
CUSTOM_LLM_CHAT_MODEL=kimi-k2-0711-preview
# Kimi K2 has no image input -> route ONLY diagram/vision analysis to OpenAI:
CUSTOM_LLM_VISION_MODEL=
VISION_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key   # used for vision only when above is set

# ===== Security (REQUIRED in production) =====
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
CORS_ORIGINS=https://your-frontend-domain.com
RATE_LIMIT_AUTH=10/minute
