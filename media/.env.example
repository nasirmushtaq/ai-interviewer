# Copy to .env and adjust.
PORT=4000

# Core API base URL and the shared token used to POST sampled frames.
CORE_API_URL=http://localhost:8000
MEDIA_SERVICE_TOKEN=dev-media-token

# Public IP the SFU advertises for WebRTC (use 127.0.0.1 for local dev).
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
# RTC port range for mediasoup workers.
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100

# How often (ms) to sample a frame per producer for AI vision.
FRAME_SAMPLE_INTERVAL_MS=6000
# JPEG width to downscale frames to before sending (smaller = cheaper/faster).
FRAME_WIDTH=640
