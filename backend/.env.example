# ============================================================================
# Copy this file to `.env` and fill in ONE provider (OpenAI or Azure OpenAI).
# The backend auto-detects Azure when AZURE_OPENAI_API_KEY + ENDPOINT are set.
# ============================================================================

# Force a provider explicitly (optional): "openai" or "azure". Blank = auto.
LLM_PROVIDER=

# ---------- Option A: Standard OpenAI ----------
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# ---------- Option C: GitHub Models (PROTOTYPING/TESTING ONLY) ----------
# Sanctioned, OpenAI-compatible, authed with a GitHub Personal Access Token
# (create at https://github.com/settings/tokens with "Models" read access).
# Rate-limited — do NOT use for production/selling. No voice (realtime) support.
GITHUB_TOKEN=
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com
GITHUB_MODELS_CHAT_MODEL=gpt-4o
GITHUB_MODELS_VISION_MODEL=gpt-4o

# ---------- Option B: Azure OpenAI ----------
# Resource endpoint, e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment NAMES you created in Azure (not model names):
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_VISION_DEPLOYMENT=
# Realtime voice (optional; often a different region/resource):
#   endpoint like https://my-rt-resource.openai.azure.com  (or wss://...)
AZURE_OPENAI_REALTIME_ENDPOINT=
AZURE_OPENAI_REALTIME_DEPLOYMENT=
AZURE_OPENAI_REALTIME_API_VERSION=2024-10-01-preview

# ---------- App ----------
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./linguacall.db
# Shared secret the media (SFU) service uses to POST frames here.
# Must match MEDIA_SERVICE_TOKEN in media/.env
MEDIA_SERVICE_TOKEN=dev-media-token
MEDIA_SERVICE_URL=http://localhost:4000

# ---------- Payments (test/sandbox) ----------
FREE_INTERVIEW_QUOTA=2
BILLING_CURRENCY=INR
PAYMENT_PROVIDER=razorpay
# Razorpay test keys (rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Cashfree sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox

# Redis for cross-instance pub/sub + caching (blank = in-memory dev fallback)
REDIS_URL=redis://localhost:6379/0

# Test/dev only: instant test-pay button + more free interviews (403 in prod)
DEV_ALLOW_TEST_PAYMENTS=false

# Feature flags: which tracks are enabled (comma list or *), and persona calls
ENABLED_TRACKS=sde
ENABLE_PERSONA_CALLS=false
